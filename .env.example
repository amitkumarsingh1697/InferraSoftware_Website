# Inferra Software website: environment variables
# Copy to .env.local for local development. Never commit real values.
# Every variable is optional: the site builds and runs without any of them.

# --- Site & SEO --------------------------------------------------------------
# Canonical production origin, no trailing slash. Used for canonical URLs,
# the sitemap, Open Graph URLs and structured data. Leave empty on previews.
NEXT_PUBLIC_SITE_URL=

# Search engine indexing. The site sends "noindex" everywhere unless this is
# "enabled" AND (outside Vercel, or VERCEL_ENV=production). Set it only on the
# production deployment once the domain and content are final.
SITE_INDEXING=

# --- Contact -----------------------------------------------------------------
# Public scheduling page (Calendly, Cal.com...). https only. Shows "Book a call".
NEXT_PUBLIC_BOOKING_URL=

# --- Enquiry delivery (server only, never exposed to the browser) -------------
# Email via Resend (https://resend.com). RESEND_API_KEY and ENQUIRY_TO_EMAIL
# are needed together.
RESEND_API_KEY=
# one address, or several separated by commas
ENQUIRY_TO_EMAIL=
# e.g. "Inferra Website <website@your-domain>", on a domain verified in Resend.
# If empty, Resend's test sender (onboarding@resend.dev) is used. It needs no
# domain but only delivers to the email address that owns the Resend account,
# so it is for testing before you have a domain.
ENQUIRY_FROM_EMAIL=

# Optional: also (or instead) POST each enquiry as JSON to an https endpoint,
# e.g. a CRM, Zapier/Make or Slack workflow webhook.
ENQUIRY_WEBHOOK_URL=
# sent as "Authorization: Bearer <secret>"
ENQUIRY_WEBHOOK_SECRET=

# If neither email nor webhook is configured, the form tells visitors that
# online enquiries are unavailable and shows the phone number instead.

# --- Analytics (off by default) -----------------------------------------------
# Cookieless Plausible analytics. Set the domain registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted or proxied script URL. The CSP allows its origin.
NEXT_PUBLIC_PLAUSIBLE_SRC=
